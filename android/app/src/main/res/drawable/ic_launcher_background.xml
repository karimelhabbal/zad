<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon background (Android 8.0 / API 26+).

  Reproduces the emerald field of the approved artwork rather than a flat fill:
  the design asset's field runs diagonally from #134F3A at the top-left to
  #0C3728 at the bottom-right (sampled from
  stitch_zad_islamic_mobile_app/minimal_zad_icon/screen.png).

  A shape drawable is used rather than `@color/...` so the icon keeps the
  design's subtle depth. Launchers may scale this layer slightly for parallax;
  a gradient is unaffected by that.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#134F3A"
        android:endColor="#0C3728"
        android:type="linear" />
</shape>
